<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Non-sandboxed, Hardened Runtime distribution (Developer ID / ad-hoc).
	     Camera access must be declared explicitly under the Hardened Runtime. -->
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>

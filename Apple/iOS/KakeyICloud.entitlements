<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Used only when a development team is configured (IOS_SIGNING_FLAGS in the Makefile; see docs/SECURITY.md): iCloud
	     (CloudKit private database) and silent push. Without a team (simulator, tests, CI) the app carries no entitlements and the
	     iCloud option is disabled. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>$(KAKEY_ICLOUD_CONTAINER)</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-environment</key>
	<string>$(KAKEY_ICLOUD_ENVIRONMENT)</string>
	<key>aps-environment</key>
	<string>$(KAKEY_APS_ENVIRONMENT)</string>
</dict>
</plist>
